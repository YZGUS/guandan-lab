{
  "name": "guandan-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,green \"npm run dev -w @guandan/server\" \"npm run dev -w @guandan/web\"",
    "start": "npm run start -w @guandan/server",
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "android:build": "cd apps/android && ./gradlew assembleDebug",
    "android:check": "cd apps/android && ./gradlew testDebugUnitTest assembleDebug lintDebug"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "typescript": "7.0.2"
  }
}
